# App URL used by the client (defaults to http://localhost:3000).
# Production should be https://www.runwithoutstops.com so canonicals and OG URLs are correct.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox Dark is the dashboard basemap (2D streets, no 3D buildings).
# Use a public token and restrict it to your domains in the Mapbox account.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Stadia still powers server-side geocoding. The public Stadia key is no longer used for tiles.
STADIA_MAPS_API_KEY=

# GraphHopper powers the customized pedestrian route.
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_API_URL=https://graphhopper.com/api/1

# Keyless development fallback only; use GraphHopper for production low-stop routing.
VALHALLA_API_URL=https://valhalla1.openstreetmap.de/route

# Tracestrack provides managed Overpass. Enable Overpass under the key's
# Allowed Services setting. The key remains server-only.
TRACESTRACK_API_KEY=
TRACESTRACK_OVERPASS_URL=https://api.tracestrack.com/overpass

# Keyless development fallback used only when TRACESTRACK_API_KEY is unset.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Clerk handles optional sign-in. Leave empty in CI; local keys come from `clerk init`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/

# Supabase stores signed-in profiles for later features. The service role stays server-only.
SUPABASE_URL=https://wxhoaurvlpfqbrpxgnmp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter powers the signed-in agent chat. Keep the key server-only.
OPENROUTER_API_KEY=

# Vercel AI Gateway key for Jev route decisions. Server-only. OpenRouter cannot serve Jev.
AI_GATEWAY_API_KEY=

# Comma-separated Clerk user ids that can open /admin and toggle models.
ADMIN_USER_IDS=

# PostHog product analytics. The public project token is safe in the browser.
# EU Cloud host: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring and tracing. The DSN is safe in the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time token for uploading source maps. Keep this server-only.
SENTRY_AUTH_TOKEN=

# Set to 1 to skip Zod env validation (CI / emergency only)
# SKIP_ENV_VALIDATION=1
