{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "runwithoutstops.com" }],
      "destination": "https://www.runwithoutstops.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "runwithoutstops.com" }],
      "destination": "https://www.runwithoutstops.com/:path*",
      "statusCode": 301
    }
  ]
}
